{
  "manifest_version": 3,
  "name": "Compass - Canvas Assistant",
  "version": "1.0",
  "key": "",
  "icons": {
    "16": "CompassLogoPlain.png",
    "48": "CompassLogoPlain.png",
    "128": "CompassLogoPlain.png"
  },
  "permissions": [
  "identity",
  "storage",
  "activeTab"
  ],
  "action": { 
    "default_title": "Compass",
    "default_icon": {
      "16": "CompassLogoPlain.png",
      "48": "CompassLogoPlain.png",
      "128": "CompassLogoPlain.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["CompassLogoPlain.png"],
      "matches": ["https://*.instructure.com/*"]
    }
  ],
  "content_scripts": [
    {
      "js": ["src/content/index.jsx"],
      "matches": ["https://*.instructure.com/*"],
      "run_at": "document_idle"
    }
  ]
}